{
  "name": "lookingglass",
  "version": "0.1.0",
  "description": "An AI-first code editor for ACP agents (Claude Code, Codex, …)",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs && node -e \"require('electron')\"",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b tsconfig.node.json tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "electron-vite build --mode smoke && node scripts/smoke.mjs",
    "package:dir": "pnpm build && electron-builder --dir",
    "package": "pnpm build && electron-builder",
    "release": "pnpm build && electron-builder --publish always",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "smoke:packaged": "node scripts/smoke.mjs release/$npm_package_version/mac-arm64/Lookingglass.app/Contents/MacOS/Lookingglass"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pierre/diffs": "^1.5.2",
    "@pierre/trees": "1.0.0-beta.6",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/markdown": "1.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "diff": "9.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ghostty-web": "^0.4.0",
    "globals": "^17.13.0",
    "lucide-react": "^1.55.0",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "zustand": "5.0.15"
  },
  "private": true,
  "dependencies": {
    "@lookingglass/acp": "workspace:*",
    "@lookingglass/forge": "workspace:*",
    "@lookingglass/review": "workspace:*",
    "@lookingglass/shared": "workspace:*",
    "@lookingglass/workspace": "workspace:*",
    "@agentclientprotocol/claude-agent-acp": "0.89.1",
    "@agentclientprotocol/sdk": "1.8.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@parcel/watcher": "^2.6.0",
    "@vscode/ripgrep": "^1.18.0",
    "electron-updater": "^6.8.9",
    "node-pty": "1.1.0",
    "source-map-js": "^1.2.2",
    "typescript-language-server": "^5.3.0",
    "zod": "4.6.6"
  }
}
